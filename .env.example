# A.I Keeper settings. Copy to /etc/aikeeper.env on the VM (deploy/install.sh does it).
# NEVER put a private key, seed phrase or the keeper's credentials here: the program refuses to
# start if it finds anything shaped like one.

AIK_DATA_DIR=./data

# Daily brief by email (Gmail app password: Google Account -> Security -> App passwords).
# Leave empty to write briefs to $AIK_DATA_DIR/briefs instead.
AIK_SMTP_USER=
AIK_SMTP_PASSWORD=
AIK_EMAIL_TO=
AIK_BRIEF_HOUR_UTC=12

# Optional overrides (defaults shown).
# AIK_RPC_URLS=https://mainnet.base.org,https://base-rpc.publicnode.com,https://base.drpc.org
# AIK_BUCKET=pfkeeperdata          # "none" to disable
# AIK_BUCKET_START=2026-09-14
# AIK_SITE=https://pandafinancial.org
# AIK_CHAIN_POLL_SECS=30
# AIK_MARKET_POLL_SECS=60
# AIK_BUCKET_POLL_SECS=21600
# AIK_SITE_POLL_SECS=3600
# AIK_PREDICT_EVERY_SECS=3600
# Laptop only (the VM uses its own read-only identity): AIK_GCS_TOKEN=$(gcloud auth print-access-token)
