# A.I Keeper settings. Copy to /etc/aikeeper.env on the VM (deploy/install.sh does it).
# NEVER put a private key, seed phrase or the keeper's credentials here: the program refuses to
# start if it finds anything shaped like one.

AIK_DATA_DIR=./data

# Daily brief by email (Gmail app password: Google Account -> Security -> App passwords).
# Leave empty to write briefs to $AIK_DATA_DIR/briefs instead.
AIK_SMTP_USER=
AIK_SMTP_PASSWORD=
AIK_EMAIL_TO=
AIK_BRIEF_HOUR_UTC=12

# Claude's read on top of the brief (one call a day). Use a key from its own Console workspace
# with a spend limit. Leave empty to send the brief without it.
AIK_ANTHROPIC_API_KEY=
# AIK_CLAUDE_MODEL=claude-opus-5-5
# AIK_CLAUDE_MONTHLY_USD=10

# The website's own report in the brief (Claude's daily site digest and weekly agent test): the same
# token as the Worker's OPS_REPORT_TOKEN secret. Leave empty for no website section.
AIK_SITE_REPORT_TOKEN=

# Aero (Aerodrome becomes Aero on 2026-10-22; see docs/AERO-VM-UPDATE.md).
# Which gauge AIK_GAUGE is: auto (probe it once), aerodrome or aero. A setting the gauge contradicts is refused.
# AIK_GAUGE_MODE=auto
# Aero's AERO/WETH pool for the AERO price. Unset: Aerodrome's AERO/WETH CL200 pool
# 0x4e506648d493C8870f55e870480f92f2F33ecE51 (one old AERO = one new AERO).
# AIK_AERO_WETH_POOL=

# Optional overrides (defaults shown).
# AIK_POOL=0x3FE04A59Ebd38cF06080a6F60a98D124eb59392A
# AIK_GAUGE=0xA0B61fdB9f1FB9b917Fe38b49427Fd4D87472D28
# AIK_PRIMARY_VAULT=0x61986afae9b07314d855e7c54949e30a866c93a8
# AIK_RPC_URLS=https://mainnet.base.org,https://base-rpc.publicnode.com,https://base.drpc.org
# AIK_BUCKET=pfkeeperdata          # "none" to disable
# AIK_BUCKET_START=2026-09-14
# AIK_SITE=https://pandafinancial.org
# AIK_CHAIN_POLL_SECS=30
# AIK_MARKET_POLL_SECS=60
# AIK_BUCKET_POLL_SECS=21600
# AIK_SITE_POLL_SECS=3600
# AIK_PREDICT_EVERY_SECS=3600
# Laptop only (the VM uses its own read-only identity): AIK_GCS_TOKEN=$(gcloud auth print-access-token)
